{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 1,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": true,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "bybit",
        "key": "fUSW4fgDPRRN8wBoGp",
        "secret": "f3wSc4TAUSPXlUw1Masi8zENSEZCd54hxj62",
        "ccxt_config": {
            "options": {
                "defaultType": "linear",
                "enableDemoTrading": true,
                "recvWindow": 10000,
                "fetchBalanceType": "spot"
            },
            "urls": {
                "enableRateLimit": true,
                "timeout": 30000,
                "api": {
                    "public": "https://api-demo.bybit.com",
                    "private": "https://api-demo.bybit.com"
                }
            },
            "leverage": 1
        },
        "ccxt_async_config": {
            "enableRateLimit": true,
            "timeout": 30000
        },
        "log_responses": true,
        "pair_whitelist": [
            "BTC/USDT:USDT"
        ],
        "pair_blacklist": [
        ]
    },
    "pairlists": [
        {"method": "StaticPairList"}
    ],
    "protections": [
        {
            "method": "MaxDrawdown",
            "lookback_period_candles": 200,
            "trade_limit": 20,
            "stop_duration_candles": 12,
            "max_allowed_drawdown": 0.2
        },
        {
            "method": "LowProfitPairs",
            "lookback_period_candles": 60,
            "trade_limit": 2,
            "stop_duration_candles": 60,
            "required_profit": 0.02
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "your_telegram_token",
        "chat_id": "your_telegram_chat_id",
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_cancel": "on",
            "entry_fill": "on",
            "exit": "on",
            "exit_cancel": "on",
            "exit_fill": "on",
            "protection_trigger": "on",
            "protection_trigger_global": "on"
        }
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 18080,
        "verbosity": "error",
        "jwt_secret_key": "somethingrandom",
        "CORS_origins": ["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8080", "http://localhost:18080"],
        "username": "freqtrader",
        "password": "SuperSecurePassword",
        "enable_openapi": true
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "edge": {
        "enabled": false
    },
    "dataformat_ohlcv": "json",
    "dataformat_trades": "jsongz"
}
